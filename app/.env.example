# Copy to .env (git-ignored) and fill in. Both values are public by design:
# the anon key is only safe because every table is locked by row-level security.
# Never put a service key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Where the audio proxy (audio-proxy/, on Deno Deploy) lives. Public, no secret in it.
EXPO_PUBLIC_AUDIO_PROXY_URL=
