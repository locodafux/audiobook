# Copy to .env.dev (default) and .env.prod (needs `hearthread --prod ...`).
# Each file has its OWN database and Telegram chat. Never commit real values.

# Supabase: URL + service key (admin API for invites) and the session-pooler
# connection string (port 5432, NOT the 6543 transaction pooler).
SUPABASE_URL=
SUPABASE_DB_URL=
SUPABASE_SERVICE_KEY=

# Where the Mac keeps its own copy of every voiced chapter: the real backup, because Telegram may
# delete files. Default: a `library` folder next to the generator's state. Point it somewhere
# that is backed up.
# HEARTHREAD_LIBRARY_DIR=

# Telegram is where phones' downloads come from. The old app's bot and chat are reused (the token
# is on the Mac and as a Supabase function secret). Proxy is optional, e.g. socks5://127.0.0.1:40000
TELEGRAM_BOT_TOKEN=
TELEGRAM_BACKUP_CHAT_ID=
# TELEGRAM_PROXY=

# Voice. Normal speed is +0%.
# TTS_VOICE=en-US-BrianNeural
# TTS_RATE=+0%
# TTS_VOLUME=+0%

# Concurrency: chapters at once, sentences per chapter, retries per sentence.
# CHAPTER_CONCURRENCY=4
# TTS_CHAPTER_CONCURRENCY=20
# TTS_MAX_RETRIES=5

# Optional: "invited by" text for `invite add` (default: your Mac user name).
# HEARTHREAD_INVITER=
