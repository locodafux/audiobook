# Edge Function secrets, set with: supabase secrets set --env-file <file>
# Names only. Real values never go in the repo.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the platform; do not set them.
R2_ACCOUNT_ID=
R2_BUCKET=
# Object Read only, scoped to the one bucket
R2_READ_KEY_ID=
R2_READ_SECRET=
